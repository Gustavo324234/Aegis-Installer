# Aegis Neural Kernel (Master Admin Passphrase encryption key)
AEGIS_ROOT_KEY=your_secure_root_key_here

# Local Whisper AI settings
AEGIS_WHISPER_MODEL=ggml-base.bin

# Comma-separated list of allowed origins for the BFF CORS policy
# Example: https://aegis.yourdomain.com,http://localhost:8000
AEGIS_ALLOWED_ORIGINS=http://localhost:8000

